---
import Base from '../layouts/Base.astro';

const email = 'simon.fabrizio01@gmail.com';

const otherProjects = [
  {
    title: 'Sistema de stock y punto de venta',
    desc: 'La primera versión del vivero: una app de venta para el celular, con PIN y carrito, que descuenta stock de una planilla de Google Sheets y oculta del catálogo web lo que se agotó.',
    tech: 'JavaScript, Google Apps Script, Google Sheets',
    image: '/img/stock-pos.webp',
    links: [
      { label: 'Código', href: 'https://github.com/SimonFabrizio/vivero-web' },
      { label: 'Demo', href: 'https://simonfabrizio.github.io/vivero-web/' },
    ],
  },
  {
    title: 'Gestión de taller mecánico',
    desc: 'Programa de consola en C para turnos y facturación de un taller, con listas y colas dinámicas, punteros y algoritmos de ordenamiento.',
    tech: 'C, estructuras de datos',
    image: null,
    links: [{ label: 'Código', href: 'https://github.com/SimonFabrizio/Auto-Mecanica' }],
  },
];

const skills = [
  { group: 'Interfaz', items: ['HTML semántico', 'CSS, Flexbox y Grid', 'JavaScript', 'Astro y Tailwind', 'Animación con GSAP', 'Accesibilidad'] },
  { group: 'Datos', items: ['Supabase', 'PostgreSQL y SQL', 'Autenticación y permisos', 'Google Apps Script'] },
  { group: 'Base', items: ['C', 'Algoritmos y estructuras de datos', 'Git y GitHub', 'Netlify y GitHub Pages'] },
];
---

<Base
  title="Simón Fabrizio, desarrollador web"
  description="Estudiante de Ingeniería en Sistemas de Información en la UTN. Hago sitios web para negocios reales, del diseño a la base de datos."
>
  <!-- Navegación -->
  <header id="site-header" class="fixed inset-x-0 top-0 z-50 mix-blend-difference text-white transition-transform duration-500 ease-[var(--ease-out-expo)] data-[hidden=true]:-translate-y-full">
    <nav class="mx-auto flex max-w-[1400px] items-center justify-between px-5 py-5 sm:px-8" aria-label="Principal">
      <a href="#inicio" class="font-display text-lg font-semibold tracking-tight">Simón Fabrizio</a>
      <div class="flex items-center gap-5 text-sm sm:gap-8">
        <a href="#proyectos" class="link-line hidden sm:inline">Proyectos</a>
        <a href="#sobre-mi" class="link-line hidden sm:inline">Sobre mí</a>
        <a href="#contacto" class="link-line">Contacto</a>
        <button
          id="theme-toggle"
          type="button"
          class="grid size-9 place-items-center rounded-full border border-white/40 transition-colors hover:bg-white hover:text-black"
          aria-label="Cambiar a modo oscuro"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="M8 1a7 7 0 0 1 0 14z" fill="currentColor"></path>
          </svg>
        </button>
      </div>
    </nav>
  </header>

  <main id="contenido">
    <!-- Hero -->
    <section id="inicio" class="mx-auto flex min-h-svh max-w-[1400px] flex-col justify-end px-5 pb-10 pt-28 sm:px-8 sm:pb-14">
      <h1
        class="font-display font-bold leading-[0.82] tracking-[-0.055em] [font-stretch:75%] text-[31vw] sm:text-[clamp(4.5rem,21vw,19rem)]"
        data-split
      >
        <span class="block">Simón</span>
        <span class="block sm:pl-[0.9em]">Fabrizio</span>
      </h1>

      <div class="mt-10 grid gap-8 border-t border-[var(--rule)] pt-6 sm:mt-14 md:grid-cols-12" data-hero-meta>
        <p class="max-w-[36ch] text-xl leading-snug md:col-span-6 md:text-2xl">
          Estudio Ingeniería en Sistemas de Información en la UTN y hago sitios web para negocios reales, del diseño a la base de datos.
        </p>
        <div class="flex flex-col gap-1 text-[var(--muted)] md:col-span-3">
          <span class="inline-flex items-center gap-2 text-[var(--fg)]">
            <span class="relative flex size-2">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-[var(--fg)] opacity-60 motion-reduce:hidden"></span>
              <span class="relative inline-flex size-2 rounded-full bg-[var(--fg)]"></span>
            </span>
            Disponible para trabajar
          </span>
          <span>Argentina</span>
        </div>
        <div class="flex items-start gap-3 md:col-span-3 md:justify-end">
          <a href="#proyectos" class="rounded-full bg-[var(--fg)] px-5 py-3 text-sm font-medium text-[var(--bg)] transition-transform duration-300 hover:-translate-y-0.5">Ver proyectos</a>
          <a href="#contacto" class="rounded-full border border-[var(--fg)] px-5 py-3 text-sm font-medium transition-colors duration-300 hover:bg-[var(--fg)] hover:text-[var(--bg)]">Escribime</a>
        </div>
      </div>
    </section>

    <!-- Proyecto principal -->
    <section id="proyectos" class="invert-block" aria-labelledby="galeria-titulo">
      <div class="mx-auto max-w-[1400px] px-5 pt-24 sm:px-8 sm:pt-32">
        <div class="grid gap-6 md:grid-cols-12 md:items-end">
          <h2 id="galeria-titulo" class="font-display text-5xl font-bold leading-[0.9] tracking-[-0.04em] [font-stretch:80%] sm:text-7xl md:col-span-8 lg:text-8xl">
            La Galería de las Plantas
          </h2>
          <p class="max-w-[40ch] text-lg text-[var(--muted)] md:col-span-4">
            El sitio de un vivero de Berisso. Está online y el dueño lo usa todos los días para mantener su catálogo al día.
          </p>
        </div>
      </div>

      <div class="mx-auto mt-12 max-w-[1400px] px-5 sm:px-8" data-reveal-wrap>
        <a
          href="https://lagaleriadelasplantas.netlify.app/"
          target="_blank"
          rel="noopener"
          class="group relative block overflow-hidden rounded-[clamp(12px,2vw,28px)]"
          aria-label="Abrir La Galería de las Plantas en una pestaña nueva"
        >
          <img
            src="/img/galeria-plantas.webp"
            width="1280"
            height="800"
            alt="Inicio de La Galería de las Plantas: la entrada del vivero llena de plantas y el título Plantas que devuelven vida a la ribera"
            class="aspect-[16/10] w-full object-cover grayscale transition-[filter] duration-700 motion-reduce:grayscale-0"
            data-reveal-img
            loading="lazy"
            decoding="async"
          />
          <span class="absolute bottom-4 right-4 inline-flex items-center gap-2 rounded-full bg-[var(--bg)] px-4 py-2 text-sm font-medium text-[var(--fg)] transition-transform duration-500 group-hover:-translate-y-1 sm:bottom-6 sm:right-6">
            Ver sitio en vivo
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
          </span>
        </a>
      </div>

      <div class="mx-auto grid max-w-[1400px] gap-10 px-5 pb-24 pt-14 sm:px-8 sm:pb-32 md:grid-cols-3">
        <div>
          <h3 class="font-display text-xl font-semibold">Para los clientes</h3>
          <p class="mt-3 text-[var(--muted)]">
            Catálogo con stock en vivo, buscador y filtros, aviso de si el vivero está abierto ahora y consulta directa por WhatsApp.
          </p>
        </div>
        <div>
          <h3 class="font-display text-xl font-semibold">Para el dueño</h3>
          <p class="mt-3 text-[var(--muted)]">
            Un panel con login donde carga plantas, fotos, precios, stock, textos y horarios sin tocar código.
          </p>
        </div>
        <div>
          <h3 class="font-display text-xl font-semibold">Cómo está hecho</h3>
          <p class="mt-3 text-[var(--muted)]">
            HTML, CSS y JavaScript sin frameworks, con Supabase (PostgreSQL con permisos por fila), imágenes WebP livianas y cabeceras de seguridad en Netlify.
          </p>
        </div>
      </div>
    </section>

    <!-- Otros proyectos -->
    <section class="mx-auto max-w-[1400px] px-5 py-24 sm:px-8 sm:py-32" aria-labelledby="otros-titulo">
      <h2 id="otros-titulo" class="font-display text-3xl font-bold tracking-[-0.03em] sm:text-4xl">Otros proyectos</h2>
      <ul class="mt-10 border-t border-[var(--rule)]">
        {
          otherProjects.map((p) => (
            <li class="group relative grid gap-4 border-b border-[var(--rule)] py-8 md:grid-cols-12 md:gap-8" data-preview={p.image ?? undefined}>
              <h3 class="font-display text-2xl font-semibold leading-tight tracking-[-0.02em] transition-transform duration-500 ease-[var(--ease-out-expo)] md:col-span-5 md:text-4xl md:group-hover:translate-x-3">
                {p.title}
              </h3>
              <div class="md:col-span-5">
                <p class="max-w-[60ch] text-[var(--muted)]">{p.desc}</p>
                <p class="mt-3 text-sm">{p.tech}</p>
              </div>
              <div class="flex gap-5 text-sm md:col-span-2 md:justify-end">
                {p.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener" class="link-line inline-flex h-fit items-center gap-1.5">
                    {l.label}
                    <svg width="10" height="10" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
                  </a>
                ))}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Sobre mí -->
    <section id="sobre-mi" class="mx-auto grid max-w-[1400px] gap-14 border-t border-[var(--rule)] px-5 py-24 sm:px-8 sm:py-32 md:grid-cols-12">
      <div class="md:col-span-6">
        <h2 class="font-display text-3xl font-bold tracking-[-0.03em] sm:text-4xl">Sobre mí</h2>
        <div class="mt-8 max-w-[58ch] space-y-5 text-lg leading-relaxed">
          <p>
            Estudio Ingeniería en Sistemas de Información en la UTN. La carrera me dio una base fuerte en algoritmos, estructuras de datos y lógica, y la uso para resolver problemas concretos.
          </p>
          <p>
            Me gusta entender todo el recorrido de un proyecto: qué necesita la persona que lo usa, cómo se guardan los datos y cómo se publica para que sea rápido y seguro.
          </p>
          <p class="text-[var(--muted)]">
            Busco mi primera experiencia profesional y también hago sitios para negocios.
          </p>
        </div>
      </div>
      <div class="grid gap-10 sm:grid-cols-3 md:col-span-6 md:pt-20">
        {
          skills.map((s) => (
            <div>
              <h3 class="border-b border-[var(--rule)] pb-2 text-sm text-[var(--muted)]">{s.group}</h3>
              <ul class="mt-3 space-y-1.5">
                {s.items.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="invert-block">
      <div class="mx-auto max-w-[1400px] px-5 py-24 sm:px-8 sm:py-32">
        <h2 class="text-lg text-[var(--muted)]">¿Tenés un proyecto o una propuesta? Escribime.</h2>
        <button
          id="copy-email"
          type="button"
          data-email={email}
          class="group mt-6 block max-w-full text-left font-display font-bold leading-[0.95] tracking-[-0.045em] [font-stretch:75%] text-[clamp(2.1rem,8.5vw,8rem)] [overflow-wrap:anywhere]"
          aria-describedby="copy-status"
        >
          <span class="link-line">{email}</span>
        </button>
        <p id="copy-status" class="mt-4 h-6 text-sm text-[var(--muted)]" aria-live="polite">Tocá el email para copiarlo.</p>

        <div class="mt-16 flex flex-wrap gap-x-8 gap-y-3 border-t border-[var(--rule)] pt-6 text-sm">
          <a href={`mailto:${email}`} class="link-line">Enviar email</a>
          <a href="https://www.linkedin.com/in/simon-fabrizio" target="_blank" rel="noopener" class="link-line">LinkedIn</a>
          <a href="https://github.com/SimonFabrizio" target="_blank" rel="noopener" class="link-line">GitHub</a>
          <span class="text-[var(--muted)] sm:ml-auto">Diseñado y programado por Simón Fabrizio, {new Date().getFullYear()}</span>
        </div>
      </div>
    </section>
  </main>

  <!-- Vista previa que sigue al cursor en "Otros proyectos" (solo escritorio) -->
  <div id="preview" class="pointer-events-none fixed left-0 top-0 z-40 hidden w-72 overflow-hidden rounded-xl opacity-0 shadow-2xl md:block" aria-hidden="true">
    <img alt="" class="aspect-[16/10] w-full object-cover object-top grayscale" />
  </div>

  <script>
    import { initSite } from '../scripts/site';
    initSite();
  </script>
</Base>
